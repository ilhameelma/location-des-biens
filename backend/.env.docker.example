# ============================================================
# SmartRent — backend/.env (à utiliser une fois le backend CONTENEURISÉ)
# Copie ce fichier en "backend/.env" (écrase l'ancien qui pointait vers
# "localhost") — toutes les adresses utilisent maintenant les NOMS DE
# SERVICE Docker (résolution DNS interne au réseau smartrent_net), pas
# "localhost", puisque chaque brique tourne dans son propre conteneur.
# ============================================================

# --- Base de données ---
DATABASE_URL=postgresql://smartrent:smartrent_pwd@postgres:5432/smartrent_db

# --- JWT --- (⚠️ change JWT_SECRET_KEY en production, voir README sécurité)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS --- (⚠️ remplace par ton domaine réel une fois en ligne)
FRONTEND_ORIGIN=http://localhost

# --- MinIO ---
# minio_endpoint : utilisé par le backend, EN INTERNE au réseau Docker
MINIO_ENDPOINT=minio:9000
# minio_public_endpoint : utilisé pour CONSTRUIRE les URLs de photos que le
# NAVIGATEUR va charger -> doit être le domaine public (ou l'IP publique),
# jamais "minio:9000" qui n'existe que dans le réseau Docker interne.
# Nginx (voir nginx/nginx.conf fourni) route déjà /smartrent-photos/ vers
# MinIO, donc il suffit de mettre ici ton domaine/IP SANS port.
MINIO_PUBLIC_ENDPOINT=tondomaine.com
MINIO_SECURE=false
MINIO_ACCESS_KEY=smartrent_admin
MINIO_SECRET_KEY=smartrent_minio_pwd
MINIO_BUCKET=smartrent-photos

# --- SMTP (notifications email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=immovision260@gmail.com
SMTP_PASSWORD=wydm ewrg foen zsdw
SMTP_FROM=ImmoVision <immovision260@gmail.com>
SMTP_USE_TLS=true

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Micro-service IA ---
ML_SERVICE_URL=http://ml_service:8001

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- Front-end URL (liens dans les emails, etc.) ---
FRONTEND_URL=http://tondomaine.com
